generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum JobStatus {
  pending
  running
  completed
  failed
}

model Job {
  id        String    @id @default(cuid())
  title     String
  type      String
  status    JobStatus @default(pending)
  version   Int       @default(0)
  createdAt DateTime  @default(now())
}
